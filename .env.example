# ==============================================================================
# BloodLink Environment Variables Template
# Copy this file to '.env' and fill in your actual values.
# NEVER commit the actual '.env' file containing real secrets to Git.
# ==============================================================================

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=bloodlink-btech-secret-key-change-in-production

# Supabase Cloud Configuration (Optional if using local PostgreSQL)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# PostgreSQL Local Database Configuration
DB_NAME=bloodlink_db
DB_USER=postgres
DB_PASSWORD=your_actual_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Admin Initial Account Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@bloodlink.org
